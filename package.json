{
  "name": "reconx",
  "version": "0.1.0",
  "private": true,
  "description": "ReconX - Invoice Reconciliation System for Medical Clinics",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "backend:dev": "npm run dev -w packages/backend",
    "frontend:dev": "npm run dev -w packages/frontend",
    "db:migrate": "npm run migrate -w packages/database",
    "db:seed": "npm run seed -w packages/database"
  },
  "keywords": [
    "invoice",
    "reconciliation",
    "medical",
    "clinic",
    "healthcare"
  ],
  "author": "",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
